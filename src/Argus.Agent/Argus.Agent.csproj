<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>argus-agent</AssemblyName>
    <RootNamespace>Argus.Agent</RootNamespace>
    <Description>Elevated monitoring agent: session lifecycle, HTTP API, SSE and JSONL recording.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Argus.Core/Argus.Core.csproj" />
    <ProjectReference Include="../Argus.Analysis/Argus.Analysis.csproj" />
    <ProjectReference Include="../Argus.Storage/Argus.Storage.csproj" />
    <ProjectReference Include="../Argus.Monitor/Argus.Monitor.csproj" />
  </ItemGroup>
</Project>
